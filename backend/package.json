{
  "name": "nettrack-dfa-backend",
  "version": "1.0.0",
  "description": "Backend API for NetTrack DFA Network Device Inventory Management with IPv4 Automata Validation",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed.js",
    "automata:generate": "node automata/exportAutomataArtifacts.js",
    "test": "jest --runInBand --detectOpenHandles"
  },
  "keywords": [
    "network-device-inventory",
    "dfa",
    "ipv4-validation",
    "mern-stack",
    "formal-languages",
